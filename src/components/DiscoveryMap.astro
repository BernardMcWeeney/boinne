---
import type { CollectionEntry } from "astro:content";

interface Props {
  locations: CollectionEntry<"locations">[];
  noteCounts: Record<string, number>;
  height?: string;
}

const { locations, noteCounts, height = '500px' } = Astro.props;

const mapData = locations.map(loc => ({
  name: loc.data.name,
  slug: loc.slug,
  teaser: loc.data.teaser,
  lat: loc.data.lat,
  lng: loc.data.lng,
  notes: noteCounts[loc.id] ?? 0,
}));
---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div
  id="boinne-map"
  class="rounded-xl overflow-hidden shadow-sm border border-stone-200/60"
  style={`height: ${height}; width: 100%;`}
  data-locations={JSON.stringify(mapData)}
></div>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var mapEl = document.getElementById('boinne-map');
  if (!mapEl || mapEl.dataset.initialized) return;
  mapEl.dataset.initialized = 'true';

  var locations = JSON.parse(mapEl.dataset.locations || '[]');

  var center = [53.7, -6.48];
  var zoom = 12;
  if (locations.length === 1) {
    center = [locations[0].lat, locations[0].lng];
    zoom = 14;
  }

  var map = L.map('boinne-map', { scrollWheelZoom: false }).setView(center, zoom);

  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/">CARTO</a>',
    maxZoom: 18,
  }).addTo(map);

  var markerIcon = L.divIcon({
    className: 'boinne-marker',
    html: '<div style="width:14px;height:14px;background:#b45309;border:3px solid #fff;border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,0.2);"></div>',
    iconSize: [14, 14],
    iconAnchor: [7, 7],
    popupAnchor: [0, -10],
  });

  var bounds = [];
  locations.forEach(function(loc) {
    var marker = L.marker([loc.lat, loc.lng], { icon: markerIcon }).addTo(map);
    marker.bindPopup(
      '<div style="font-family:Inter,system-ui,sans-serif;min-width:180px;padding:6px 0;">' +
        '<strong style="font-size:15px;color:#1c1917;font-weight:700;">' + loc.name + '</strong><br>' +
        '<span style="font-size:13px;color:#78716c;line-height:1.5;display:block;margin:6px 0 10px;">' + loc.teaser + '</span>' +
        '<a href="/locations/' + loc.slug + '/" style="color:#b45309;font-size:13px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:4px;">Explore <span style="font-size:16px;">&rarr;</span></a>' +
      '</div>'
    );
    bounds.push([loc.lat, loc.lng]);
  });

  if (bounds.length > 1) {
    map.fitBounds(bounds, { padding: [50, 50] });
  }
});
</script>
