---
import type { CollectionEntry } from "astro:content";

interface Props {
  locations: CollectionEntry<"locations">[];
  noteCounts: Record<string, number>;
  height?: string;
}

const { locations, noteCounts, height = '500px' } = Astro.props;

const mapData = locations.map(loc => ({
  name: loc.data.name,
  slug: loc.slug,
  teaser: loc.data.teaser,
  lat: loc.data.lat,
  lng: loc.data.lng,
  notes: noteCounts[loc.id] ?? 0,
}));
---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div
  id="boinne-map"
  class="rounded-lg overflow-hidden border border-stone-200/40"
  style={`height: ${height}; width: 100%;`}
  data-locations={JSON.stringify(mapData)}
></div>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var mapEl = document.getElementById('boinne-map');
  if (!mapEl || mapEl.dataset.initialized) return;
  mapEl.dataset.initialized = 'true';

  var locations = JSON.parse(mapEl.dataset.locations || '[]');

  var center = [53.7, -6.48];
  var zoom = 12;
  if (locations.length === 1) {
    center = [locations[0].lat, locations[0].lng];
    zoom = 14;
  }

  var map = L.map('boinne-map', { scrollWheelZoom: false }).setView(center, zoom);

  L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/">CARTO</a>',
    maxZoom: 18,
  }).addTo(map);

  var markerIcon = L.divIcon({
    className: 'boinne-marker',
    html: '<div style="width:12px;height:12px;background:#ffd54f;border:2px solid rgba(255,255,255,0.9);border-radius:50%;box-shadow:0 0 8px rgba(255,213,79,0.4);"></div>',
    iconSize: [12, 12],
    iconAnchor: [6, 6],
    popupAnchor: [0, -8],
  });

  var bounds = [];
  locations.forEach(function(loc) {
    var marker = L.marker([loc.lat, loc.lng], { icon: markerIcon }).addTo(map);
    marker.bindPopup(
      '<div style="font-family:Inter,system-ui,sans-serif;min-width:180px;padding:4px 0;">' +
        '<strong style="font-size:14px;color:#1c1917;font-weight:700;">' + loc.name + '</strong>' +
        '<span style="font-size:12px;color:#78716c;line-height:1.5;display:block;margin:4px 0 8px;">' + loc.teaser + '</span>' +
        '<a href="/locations/' + loc.slug + '/" style="color:#92400e;font-size:12px;font-weight:600;text-decoration:none;">Explore &rarr;</a>' +
      '</div>'
    );
    bounds.push([loc.lat, loc.lng]);
  });

  if (bounds.length > 1) {
    map.fitBounds(bounds, { padding: [50, 50] });
  }
});
</script>
