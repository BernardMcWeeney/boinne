---
import type { CollectionEntry } from "astro:content";
import { getLocationGradient } from "../lib/images";

interface Props {
  note: CollectionEntry<"posts">;
  locationById: Map<string, CollectionEntry<"locations">>;
  erasById: Map<string, CollectionEntry<"eras">>;
}

const { note, locationById, erasById } = Astro.props;

const noteLocation = locationById.get(note.data.location.id);
const gradient = noteLocation ? getLocationGradient(noteLocation.slug) : undefined;

const formattedDate = note.data.publishedAt.toLocaleDateString('en-IE', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const typeLabels: Record<string, string> = {
  ruin: 'Ruin',
  landscape: 'Landscape',
  artefact: 'Artefact',
  'oral-history': 'Oral History',
  event: 'Event',
};
const typeLabel = typeLabels[note.data.discoveryType] || note.data.discoveryType;
---

<a href={`/notes/${note.slug}/`} class="note-card group block">
  <div class="note-card-accent" style={gradient ? `background: ${gradient};` : 'background: #d6d3d1;'} />
  <div class="note-card-body">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-base font-bold text-stone-900 group-hover:text-gold-dim transition-colors leading-snug">
        {note.data.title}
      </h3>
      <span class="flex-shrink-0 text-[10px] font-semibold uppercase tracking-wider text-stone-400 bg-stone-100 px-2 py-0.5 rounded">
        {typeLabel}
      </span>
    </div>
    <p class="mt-2 text-sm text-stone-500 leading-relaxed line-clamp-2">{note.data.excerpt}</p>
    <div class="mt-3 flex items-center gap-4 text-xs text-stone-400">
      <time datetime={note.data.publishedAt.toISOString()}>{formattedDate}</time>
      {noteLocation && (
        <span class="flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          {noteLocation.data.name}
        </span>
      )}
    </div>
  </div>
</a>
