---
import type { CollectionEntry } from "astro:content";

interface Props {
  note: CollectionEntry<"posts">;
  locationById: Map<string, CollectionEntry<"locations">>;
  erasById: Map<string, CollectionEntry<"eras">>;
}

const { note, locationById, erasById } = Astro.props;

const noteLocation = locationById.get(note.data.location.id);

const formattedDate = note.data.publishedAt.toLocaleDateString('en-IE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a
  href={`/notes/${note.slug}/`}
  class="group block py-5 border-b border-stone-200/80 last:border-b-0 hover:bg-stone-50/50 -mx-2 px-2 rounded-lg transition-colors duration-200"
>
  <div class="flex items-baseline justify-between gap-4 flex-wrap">
    <h3 class="font-display text-base font-bold text-stone-900 group-hover:text-gold-dim transition-colors leading-snug">
      {note.data.title}
    </h3>
    <time class="text-xs text-stone-400 whitespace-nowrap" datetime={note.data.publishedAt.toISOString()}>
      {formattedDate}
    </time>
  </div>
  <p class="mt-1.5 text-sm text-stone-500 leading-relaxed line-clamp-2">{note.data.excerpt}</p>
  {noteLocation && (
    <div class="mt-2 flex items-center gap-1.5 text-xs text-stone-400">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
      </svg>
      {noteLocation.data.name}
    </div>
  )}
</a>
