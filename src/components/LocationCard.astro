---
import type { CollectionEntry } from "astro:content";
import EraPill from "./EraPill.astro";
import { getLocationGradient } from "../lib/images";

interface Props {
  location: CollectionEntry<"locations">;
  erasById: Map<string, CollectionEntry<"eras">>;
  noteCount?: number;
}

const { location, erasById, noteCount = 0 } = Astro.props;
const locationEras = location.data.eras
  .map((ref) => erasById.get(ref.id))
  .filter((era): era is CollectionEntry<"eras"> => Boolean(era));

const gradient = getLocationGradient(location.slug);
---

<a
  href={`/locations/${location.slug}/`}
  class="group flex items-start gap-5 py-5 border-b border-stone-200/80 last:border-b-0 hover:bg-stone-50/50 -mx-2 px-2 rounded-lg transition-colors duration-200"
>
  <div
    class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden placeholder-shimmer relative"
    style={`background: ${gradient};`}
  />
  <div class="flex-1 min-w-0">
    <div class="flex items-baseline gap-3 flex-wrap">
      <h3 class="font-display text-lg font-bold text-stone-900 group-hover:text-gold-dim transition-colors">
        {location.data.name}
      </h3>
      <span class="text-xs text-stone-400">{location.data.county}</span>
    </div>
    <p class="mt-1 text-sm text-stone-500 leading-relaxed line-clamp-2">{location.data.teaser}</p>
    <div class="mt-2 flex items-center gap-2 flex-wrap">
      {locationEras.map(era => (
        <EraPill era={era} linked={false} />
      ))}
      {noteCount > 0 && (
        <span class="text-[10px] text-stone-400 font-medium ml-1">{noteCount} {noteCount === 1 ? 'entry' : 'entries'}</span>
      )}
    </div>
  </div>
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="flex-shrink-0 w-4 h-4 text-stone-300 group-hover:text-gold-dim group-hover:translate-x-0.5 transition-all mt-1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
  </svg>
</a>
