---
import type { CollectionEntry } from "astro:content";
import EraPill from "./EraPill.astro";
import { getLocationGradient } from "../lib/images";

interface Props {
  location: CollectionEntry<"locations">;
  erasById: Map<string, CollectionEntry<"eras">>;
  noteCount?: number;
}

const { location, erasById, noteCount = 0 } = Astro.props;
const locationEras = location.data.eras
  .map((ref) => erasById.get(ref.id))
  .filter((era): era is CollectionEntry<"eras"> => Boolean(era));

const gradient = getLocationGradient(location.slug);
---

<a href={`/locations/${location.slug}/`} class="visual-card group block">
  <div class="visual-card-hero placeholder-shimmer relative" style={`background: ${gradient};`}>
    <div class="absolute bottom-0 left-0 right-0 z-10 p-4">
      <div class="flex flex-wrap gap-1.5 mb-2">
        {locationEras.map(era => (
          <EraPill era={era} linked={false} variant="light" />
        ))}
      </div>
      <h3 class="font-display text-xl font-bold text-white group-hover:text-gold transition-colors leading-tight">
        {location.data.name}
      </h3>
      <p class="text-xs text-white/40 mt-0.5">{location.data.county}</p>
    </div>
  </div>
  <div class="visual-card-body">
    <p class="text-sm text-stone-500 leading-relaxed line-clamp-2">{location.data.teaser}</p>
    <div class="mt-3 flex items-center justify-between">
      {noteCount > 0 && (
        <span class="text-[11px] text-stone-400 font-medium">{noteCount} {noteCount === 1 ? 'entry' : 'entries'}</span>
      )}
      <span class="text-[11px] font-semibold text-gold-dim group-hover:text-gold-dim/80 transition-colors ml-auto">
        Explore &rarr;
      </span>
    </div>
  </div>
</a>
