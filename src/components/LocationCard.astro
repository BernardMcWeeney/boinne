---
import type { CollectionEntry } from "astro:content";
import EraPill from "./EraPill.astro";
import { getLocationGradient } from "../lib/images";

interface Props {
  location: CollectionEntry<"locations">;
  erasById: Map<string, CollectionEntry<"eras">>;
  noteCount?: number;
}

const { location, erasById, noteCount = 0 } = Astro.props;
const locationEras = location.data.eras
  .map((ref) => erasById.get(ref.id))
  .filter((era): era is CollectionEntry<"eras"> => Boolean(era));

const gradient = getLocationGradient(location.slug);
---

<a
  href={`/locations/${location.slug}/`}
  class="group block rounded-xl overflow-hidden bg-white border border-stone-200/80 hover:shadow-lg hover:shadow-stone-200/50 hover:-translate-y-0.5 transition-all duration-300"
>
  <div
    class="relative h-48 overflow-hidden placeholder-shimmer"
    style={`background: ${gradient};`}
  >
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" />
    <div class="absolute bottom-4 left-4 right-4 flex flex-wrap gap-1.5">
      {locationEras.map(era => (
        <EraPill era={era} linked={false} variant="light" />
      ))}
    </div>
    {noteCount > 0 && (
      <div class="absolute top-4 right-4">
        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-black/30 text-white/80 text-[11px] font-medium">
          {noteCount} {noteCount === 1 ? 'note' : 'notes'}
        </span>
      </div>
    )}
  </div>
  <div class="p-5">
    <h3 class="text-lg font-bold text-stone-900 group-hover:text-amber-700 transition-colors">
      {location.data.name}
    </h3>
    <p class="text-xs text-stone-400 mt-0.5">{location.data.county}</p>
    <p class="mt-2 text-sm text-stone-500 leading-relaxed line-clamp-2">{location.data.teaser}</p>
  </div>
</a>
