---
import type { CollectionEntry } from "astro:content";
import EraPill from "./EraPill.astro";

interface Props {
  location: CollectionEntry<"locations">;
  erasById: Map<string, CollectionEntry<"eras">>;
  noteCount?: number;
}

const { location, erasById, noteCount = 0 } = Astro.props;
const locationEras = location.data.eras
  .map((ref) => erasById.get(ref.id))
  .filter((era): era is CollectionEntry<"eras"> => Boolean(era));
---

<article class="glass-card flex h-full flex-col overflow-hidden">
  <a href={`/locations/${location.slug}/`} class="block landscape-frame m-3 mb-0">
    <img
      src={location.data.heroImage}
      alt={`Landscape view for ${location.data.name}`}
      class="h-52 w-full object-cover transition duration-500 hover:scale-[1.04]"
      loading="lazy"
    />
  </a>
  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h3 class="text-3xl text-stone-900">{location.data.name}</h3>
        <p class="text-sm tracking-wide text-stone-600">{location.data.county}</p>
      </div>
      <span class="chip">{noteCount} notes</span>
    </div>
    <p class="text-sm text-stone-700">{location.data.teaser}</p>
    <div class="flex flex-wrap gap-2">
      {locationEras.map((era) => <EraPill era={era} />)}
    </div>
    <a
      href={`/locations/${location.slug}/`}
      class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-river underline decoration-2 underline-offset-4"
    >
      Explore site
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
