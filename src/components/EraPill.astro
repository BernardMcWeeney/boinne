---
import type { CollectionEntry } from "astro:content";
import { getEraAccentColor } from "../lib/images";

interface Props {
  era: CollectionEntry<"eras">;
  linked?: boolean;
  variant?: 'default' | 'light';
}

const { era, linked = true, variant = 'default' } = Astro.props;
const Tag = linked ? 'a' : 'span';
const accentColor = getEraAccentColor(era.slug);
---

<Tag
  href={linked ? `/eras/${era.slug}/` : undefined}
  class:list={[
    'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-semibold uppercase tracking-wider transition-all duration-200',
    variant === 'light'
      ? 'border border-white/15 text-white/70 hover:text-gold hover:border-gold/40 bg-white/5'
      : 'border border-stone-200 text-stone-500 hover:text-stone-800 hover:border-stone-400 bg-stone-50',
    linked && 'cursor-pointer',
  ]}
>
  <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style={`background-color: ${accentColor};`} />
  {era.data.name}
</Tag>
