---
import type { CollectionEntry } from "astro:content";

interface Props {
  era: CollectionEntry<"eras">;
  linked?: boolean;
  variant?: 'default' | 'light';
}

const { era, linked = true, variant = 'default' } = Astro.props;
const Tag = linked ? 'a' : 'span';
---

<Tag
  href={linked ? `/eras/${era.slug}/` : undefined}
  class:list={[
    'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider transition-colors duration-200',
    variant === 'light'
      ? 'border border-white/20 text-white/70 hover:text-gold hover:border-gold/40'
      : 'border border-stone-200 text-stone-500 hover:text-stone-800 hover:border-stone-400',
    linked && 'cursor-pointer',
  ]}
>
  {era.data.name}
</Tag>
