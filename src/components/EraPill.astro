---
import type { CollectionEntry } from "astro:content";

interface Props {
  era: CollectionEntry<"eras">;
  linked?: boolean;
  variant?: 'default' | 'light';
}

const { era, linked = true, variant = 'default' } = Astro.props;
const Tag = linked ? 'a' : 'span';
---

<Tag
  href={linked ? `/eras/${era.slug}/` : undefined}
  class:list={[
    'inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold uppercase tracking-wider transition-colors',
    variant === 'light'
      ? 'bg-white/15 text-white/90 hover:bg-white/25'
      : 'bg-amber-50 text-amber-700 hover:bg-amber-100',
    linked && 'cursor-pointer',
  ]}
>
  {era.data.name}
</Tag>
