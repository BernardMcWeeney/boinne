---
import { getCollection } from "astro:content";
import DiscoveryMap from "../components/DiscoveryMap.astro";
import LocationCard from "../components/LocationCard.astro";
import NoteCard from "../components/NoteCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const [locations, notes, eras] = await Promise.all([
  getCollection("locations"),
  getCollection("posts"),
  getCollection("eras"),
]);

const locationsSorted = [...locations].sort((a, b) => a.data.name.localeCompare(b.data.name));
const notesSorted = [...notes].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const erasSorted = [...eras].sort((a, b) => a.data.order - b.data.order);

const locationById = new Map(locations.map((l) => [l.id, l]));
const erasById = new Map(eras.map((e) => [e.id, e]));

const noteCounts = notes.reduce<Record<string, number>>((acc, note) => {
  const key = note.data.location.id;
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});
---

<BaseLayout title="Bóinne | Boyne Valley History" darkHeader={true}>
  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden"
    style="background: linear-gradient(145deg, #0f0f1a 0%, #1a1a2e 25%, #16213e 50%, #0f3460 75%, #1a1a2e 100%);"
  >
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 20% 50%, rgba(180,83,9,0.3), transparent 50%), radial-gradient(circle at 80% 30%, rgba(59,130,246,0.15), transparent 50%);"></div>
    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
      <p class="text-amber-400/80 text-sm font-semibold uppercase tracking-[0.25em] mb-6">The Boyne Valley</p>
      <h1 class="font-display text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-black text-white leading-[0.85] tracking-tight">
        Bóinne
      </h1>
      <p class="mt-8 text-lg sm:text-xl text-stone-300 max-w-2xl mx-auto leading-relaxed">
        Five thousand years of history carved into the landscape of County Meath.
        A personal exploration of Ireland's most ancient valley.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/locations/" class="inline-flex items-center gap-2 px-7 py-3.5 bg-amber-600 hover:bg-amber-500 text-white font-semibold rounded-full transition-colors">
          Explore Locations
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
        <a href="/map/" class="inline-flex items-center gap-2 px-7 py-3.5 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-full border border-white/20 transition-colors">
          View Map
        </a>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-surface to-transparent"></div>
  </section>

  <!-- Locations -->
  <section class="px-6 py-20">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-amber-700 mb-2">Discover</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-stone-900">Ancient Sites</h2>
        </div>
        <a href="/locations/" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-amber-700 hover:text-amber-800 transition-colors">
          All locations
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {locationsSorted.map(loc => (
          <LocationCard location={loc} erasById={erasById} noteCount={noteCounts[loc.id] ?? 0} />
        ))}
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="px-6 py-20 bg-stone-50">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-amber-700 mb-2">Navigate</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-stone-900">The Valley</h2>
        </div>
        <a href="/map/" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-amber-700 hover:text-amber-800 transition-colors">
          Full map
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
      <DiscoveryMap locations={locationsSorted} noteCounts={noteCounts} height="520px" />
    </div>
  </section>

  <!-- Journal -->
  <section class="px-6 py-20">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-amber-700 mb-2">Read</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-stone-900">Latest Writings</h2>
        </div>
        <a href="/notes/" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-amber-700 hover:text-amber-800 transition-colors">
          All entries
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {notesSorted.slice(0, 3).map(note => (
          <NoteCard note={note} locationById={locationById} erasById={erasById} />
        ))}
      </div>
    </div>
  </section>

  <!-- Eras -->
  <section class="px-6 py-20 bg-stone-900">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12">
        <p class="text-xs font-semibold uppercase tracking-wider text-amber-400 mb-2">Timeline</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white">Through the Ages</h2>
        <p class="mt-3 text-stone-400 max-w-xl">The Boyne Valley spans every major era of Irish history.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {erasSorted.map(era => (
          <a href={`/eras/${era.slug}/`} class="group relative block p-6 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 hover:border-amber-500/30 transition-all duration-300">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-400 mb-2">{era.data.span}</p>
            <h3 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors">{era.data.name}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
