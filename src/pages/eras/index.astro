---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEraGradient, getEraAccentColor } from "../../lib/images";

const [eras, locations, notes] = await Promise.all([
  getCollection("eras"),
  getCollection("locations"),
  getCollection("posts"),
]);

const erasSorted = [...eras].sort((a, b) => a.data.order - b.data.order);

const stats = erasSorted.map((era) => {
  const locationCount = locations.filter((location) =>
    location.data.eras.some((locationEra) => locationEra.id === era.id),
  ).length;

  const noteCount = notes.filter((note) => note.data.eras.some((noteEra) => noteEra.id === era.id)).length;

  return { era, locationCount, noteCount };
});
---

<BaseLayout title="Eras | Bóinne" description="Chronological index for all eras represented in the Boyne Valley.">
  <section class="bg-dark pt-28 pb-16 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="mb-6">
        <Breadcrumbs crumbs={[
          { label: 'Home', href: '/' },
          { label: 'Eras' },
        ]} variant="light" />
      </div>
      <p class="text-[11px] font-semibold uppercase tracking-wider text-gold/50 mb-3">Chronology</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white">Through the Ages</h1>
      <p class="mt-4 text-base text-white/40 leading-relaxed max-w-xl">
        A journey through five millennia of history in the Boyne Valley.
        Each location can belong to multiple eras, supporting layered history.
      </p>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-5xl mx-auto">
      <div class="space-y-4">
        {stats.map(({ era, locationCount, noteCount }) => (
          <a
            href={`/eras/${era.slug}/`}
            class="group block rounded-xl overflow-hidden border border-stone-200 hover:border-stone-300 transition-all hover:shadow-lg"
          >
            <div class="flex flex-col sm:flex-row">
              <div class="sm:w-48 h-32 sm:h-auto relative placeholder-shimmer flex-shrink-0" style={`background: ${getEraGradient(era.slug)};`}>
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="text-white/60 text-xs font-semibold uppercase tracking-wider">{era.data.span}</span>
                </div>
              </div>
              <div class="flex-1 p-6">
                <h2 class="font-display text-xl font-bold text-stone-900 group-hover:text-gold-dim transition-colors">{era.data.name}</h2>
                <p class="mt-2 text-sm text-stone-500 leading-relaxed">{era.data.summary}</p>
                <div class="mt-4 flex items-center gap-4 text-xs text-stone-400">
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full" style={`background-color: ${getEraAccentColor(era.slug)};`} />
                    {locationCount} {locationCount === 1 ? 'site' : 'sites'}
                  </span>
                  <span class="w-1 h-1 rounded-full bg-stone-300" />
                  <span>{noteCount} {noteCount === 1 ? 'entry' : 'entries'}</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
