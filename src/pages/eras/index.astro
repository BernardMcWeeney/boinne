---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEraGradient } from "../../lib/images";

const [eras, locations, notes] = await Promise.all([
  getCollection("eras"),
  getCollection("locations"),
  getCollection("posts"),
]);

const erasSorted = [...eras].sort((a, b) => a.data.order - b.data.order);

const stats = erasSorted.map((era) => {
  const locationCount = locations.filter((location) =>
    location.data.eras.some((locationEra) => locationEra.id === era.id),
  ).length;

  const noteCount = notes.filter((note) => note.data.eras.some((noteEra) => noteEra.id === era.id)).length;

  return { era, locationCount, noteCount };
});
---

<BaseLayout title="Eras | Bóinne" description="Chronological index for all eras represented in the Boyne Valley.">
  <section class="px-6 pt-24 pb-20">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-2xl mb-14">
        <p class="text-xs font-semibold uppercase tracking-wider text-amber-700 mb-3">Timeline</p>
        <h1 class="text-4xl sm:text-5xl font-bold text-stone-900">Through the Ages</h1>
        <p class="mt-4 text-lg text-stone-500 leading-relaxed">
          The Boyne Valley spans every major era of Irish history. Each location
          can belong to multiple eras, supporting layered history rather than a
          one-period-per-site model.
        </p>
      </div>
      <div class="space-y-4">
        {stats.map(({ era, locationCount, noteCount }) => (
          <a href={`/eras/${era.slug}/`} class="group block rounded-xl border border-stone-200 bg-white hover:border-amber-300 hover:shadow-sm transition-all overflow-hidden">
            <div class="flex flex-col sm:flex-row">
              <div class="sm:w-48 h-32 sm:h-auto flex-shrink-0 placeholder-shimmer" style={`background: ${getEraGradient(era.slug)};`} />
              <div class="flex-1 p-6 sm:p-7">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-700 mb-1">{era.data.span}</p>
                <h2 class="text-2xl font-bold text-stone-900 group-hover:text-amber-700 transition-colors">{era.data.name}</h2>
                <p class="mt-2 text-sm text-stone-500 leading-relaxed line-clamp-2">{era.data.summary}</p>
                <div class="mt-4 flex items-center gap-4 text-xs font-medium text-stone-400">
                  <span>{locationCount} {locationCount === 1 ? 'location' : 'locations'}</span>
                  <span class="w-1 h-1 rounded-full bg-stone-300" />
                  <span>{noteCount} {noteCount === 1 ? 'note' : 'notes'}</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
