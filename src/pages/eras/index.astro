---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const [eras, locations, notes] = await Promise.all([
  getCollection("eras"),
  getCollection("locations"),
  getCollection("posts"),
]);

const erasSorted = [...eras].sort((a, b) => a.data.order - b.data.order);

const stats = erasSorted.map((era) => {
  const locationCount = locations.filter((location) =>
    location.data.eras.some((locationEra) => locationEra.id === era.id),
  ).length;

  const noteCount = notes.filter((note) => note.data.eras.some((noteEra) => noteEra.id === era.id)).length;

  return { era, locationCount, noteCount };
});
---

<BaseLayout title="Eras | Bóinne" description="Chronological index for all eras represented in the Boyne Valley.">
  <!-- Dark header area -->
  <section class="bg-dark pt-28 pb-16 px-6">
    <div class="max-w-3xl mx-auto">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-gold/50 mb-3">Chronology</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white">Through the Ages</h1>
      <p class="mt-4 text-base text-white/40 leading-relaxed max-w-xl">
        A journey through five millennia of history in the Boyne Valley.
        Each location can belong to multiple eras, supporting layered history.
      </p>
    </div>
  </section>

  <!-- Timeline -->
  <section class="px-6 py-16">
    <div class="max-w-3xl mx-auto">
      <div class="timeline">
        {stats.map(({ era, locationCount, noteCount }) => (
          <div class="timeline-entry reveal">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-stone-400 mb-1">{era.data.span}</p>
            <h2 class="font-display text-2xl font-bold text-stone-900">
              <a href={`/eras/${era.slug}/`} class="hover:text-gold-dim transition-colors">{era.data.name}</a>
            </h2>
            <p class="mt-2 text-sm text-stone-500 leading-relaxed">{era.data.summary}</p>
            <div class="mt-3 flex items-center gap-4 text-xs text-stone-400">
              <span>{locationCount} {locationCount === 1 ? 'site' : 'sites'}</span>
              <span class="w-1 h-1 rounded-full bg-stone-300" />
              <span>{noteCount} {noteCount === 1 ? 'entry' : 'entries'}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
