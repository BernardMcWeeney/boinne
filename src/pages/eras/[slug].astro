---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import LocationCard from "../../components/LocationCard.astro";
import NoteCard from "../../components/NoteCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEraGradient } from "../../lib/images";

export async function getStaticPaths() {
  const eras = await getCollection("eras");
  return eras.map((era) => ({
    params: { slug: era.slug },
    props: { era },
  }));
}

const { era } = Astro.props as { era: CollectionEntry<"eras"> };
const { Content } = await render(era);

const [allEras, allLocations, allNotes] = await Promise.all([
  getCollection("eras"),
  getCollection("locations"),
  getCollection("posts"),
]);

const erasById = new Map(allEras.map((entry) => [entry.id, entry]));
const locationById = new Map(allLocations.map((location) => [location.id, location]));

const notesForEra = [...allNotes]
  .filter((note) => note.data.eras.some((noteEra) => noteEra.id === era.id))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const locationsForEra = allLocations.filter((location) =>
  location.data.eras.some((locationEra) => locationEra.id === era.id),
);

const noteCounts = allNotes.reduce<Record<string, number>>((acc, note) => {
  const key = note.data.location.id;
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});

const gradient = getEraGradient(era.slug);
---

<BaseLayout title={`${era.data.name} | Bóinne`} description={era.data.summary} darkHeader={true}>
  <!-- Hero -->
  <section class="relative min-h-[45vh] flex items-end overflow-hidden placeholder-shimmer" style={`background: ${gradient};`}>
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pb-12 pt-32">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-400 mb-3">{era.data.span}</p>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white">{era.data.name}</h1>
      <p class="mt-4 text-lg text-white/70 max-w-2xl leading-relaxed">{era.data.summary}</p>
      <div class="mt-4 flex items-center gap-4 text-sm text-white/40">
        <span>{locationsForEra.length} {locationsForEra.length === 1 ? 'location' : 'locations'}</span>
        <span class="w-1 h-1 rounded-full bg-white/30" />
        <span>{notesForEra.length} {notesForEra.length === 1 ? 'note' : 'notes'}</span>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="px-6 py-16">
    <div class="max-w-3xl mx-auto">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  <!-- Locations -->
  {locationsForEra.length > 0 && (
    <section class="px-6 pb-16">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-stone-400 mb-8 pb-4 border-b border-stone-200">Locations in this Era</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {locationsForEra.map((location) => (
            <LocationCard location={location} erasById={erasById} noteCount={noteCounts[location.id] ?? 0} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Notes -->
  {notesForEra.length > 0 && (
    <section class="px-6 pb-20">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-stone-400 mb-8 pb-4 border-b border-stone-200">Journal Entries</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {notesForEra.map((note) => (
            <NoteCard note={note} locationById={locationById} erasById={erasById} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
