---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import LocationCard from "../../components/LocationCard.astro";
import NoteCard from "../../components/NoteCard.astro";
import Infobox from "../../components/Infobox.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEraGradient } from "../../lib/images";

export async function getStaticPaths() {
  const eras = await getCollection("eras");
  return eras.map((era) => ({
    params: { slug: era.slug },
    props: { era },
  }));
}

const { era } = Astro.props as { era: CollectionEntry<"eras"> };
const { Content } = await render(era);

const [allEras, allLocations, allNotes] = await Promise.all([
  getCollection("eras"),
  getCollection("locations"),
  getCollection("posts"),
]);

const erasById = new Map(allEras.map((entry) => [entry.id, entry]));
const locationById = new Map(allLocations.map((location) => [location.id, location]));

const notesForEra = [...allNotes]
  .filter((note) => note.data.eras.some((noteEra) => noteEra.id === era.id))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const locationsForEra = allLocations.filter((location) =>
  location.data.eras.some((locationEra) => locationEra.id === era.id),
);

const noteCounts = allNotes.reduce<Record<string, number>>((acc, note) => {
  const key = note.data.location.id;
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});

const gradient = getEraGradient(era.slug);

// Find adjacent eras for navigation
const sortedEras = [...allEras].sort((a, b) => a.data.order - b.data.order);
const currentIndex = sortedEras.findIndex(e => e.id === era.id);
const prevEra = currentIndex > 0 ? sortedEras[currentIndex - 1] : null;
const nextEra = currentIndex < sortedEras.length - 1 ? sortedEras[currentIndex + 1] : null;

const infoRows = [
  { label: 'Period', value: era.data.span },
  { label: 'Sites', value: String(locationsForEra.length) },
  { label: 'Journal Entries', value: String(notesForEra.length) },
];
---

<BaseLayout title={`${era.data.name} | Bóinne`} description={era.data.summary}>
  <!-- Hero -->
  <section class="relative min-h-[50vh] flex items-end overflow-hidden vignette placeholder-shimmer" style={`background: ${gradient};`}>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent" />
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pb-14 pt-36">
      <div class="mb-6">
        <Breadcrumbs crumbs={[
          { label: 'Home', href: '/' },
          { label: 'Eras', href: '/eras/' },
          { label: era.data.name },
        ]} variant="light" />
      </div>
      <p class="text-[11px] font-semibold uppercase tracking-wider text-gold/70 mb-3">{era.data.span}</p>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-white">{era.data.name}</h1>
      <div class="mt-4 flex items-center gap-4 text-sm text-white/30">
        <span>{locationsForEra.length} {locationsForEra.length === 1 ? 'site' : 'sites'}</span>
        <span class="w-1 h-1 rounded-full bg-white/20" />
        <span>{notesForEra.length} {notesForEra.length === 1 ? 'entry' : 'entries'}</span>
      </div>
    </div>
  </section>

  <!-- Article with sidebar -->
  <section class="px-6 py-16">
    <div class="article-grid">
      <!-- Main content -->
      <div>
        <p class="text-lg text-stone-600 leading-relaxed font-light mb-10 reveal">{era.data.summary}</p>
        <div class="prose reveal">
          <Content />
        </div>

        {locationsForEra.length > 0 && (
          <div class="see-also reveal">
            <h2 class="see-also-title">Sites from This Era</h2>
            <div class="card-grid">
              {locationsForEra.map((location) => (
                <LocationCard location={location} erasById={erasById} noteCount={noteCounts[location.id] ?? 0} />
              ))}
            </div>
          </div>
        )}

        {notesForEra.length > 0 && (
          <div class="see-also reveal">
            <h2 class="see-also-title">Journal Entries</h2>
            <div class="card-grid">
              {notesForEra.map((note) => (
                <NoteCard note={note} locationById={locationById} erasById={erasById} />
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="sidebar-sticky space-y-6">
        <Infobox title={era.data.name} gradient={gradient} rows={infoRows} />

        <!-- Era navigation -->
        <div class="space-y-2">
          {prevEra && (
            <a href={`/eras/${prevEra.slug}/`} class="group flex items-center gap-3 p-3 bg-white border border-stone-200 rounded-lg hover:border-stone-300 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3 text-stone-400 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
              </svg>
              <div class="min-w-0">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">Previous Era</p>
                <p class="text-sm font-medium text-stone-700 group-hover:text-gold-dim transition-colors truncate">{prevEra.data.name}</p>
              </div>
            </a>
          )}
          {nextEra && (
            <a href={`/eras/${nextEra.slug}/`} class="group flex items-center justify-between gap-3 p-3 bg-white border border-stone-200 rounded-lg hover:border-stone-300 transition-colors">
              <div class="min-w-0">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">Next Era</p>
                <p class="text-sm font-medium text-stone-700 group-hover:text-gold-dim transition-colors truncate">{nextEra.data.name}</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3 text-stone-400 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </a>
          )}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
