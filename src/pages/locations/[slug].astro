---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import EraPill from "../../components/EraPill.astro";
import NoteCard from "../../components/NoteCard.astro";
import DiscoveryMap from "../../components/DiscoveryMap.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocationGradient } from "../../lib/images";

export async function getStaticPaths() {
  const locations = await getCollection("locations");
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props as { location: CollectionEntry<"locations"> };
const { Content } = await render(location);

const [allNotes, allLocations, allEras] = await Promise.all([
  getCollection("posts"),
  getCollection("locations"),
  getCollection("eras"),
]);

const erasById = new Map(allEras.map((e) => [e.id, e]));
const locationById = new Map(allLocations.map((l) => [l.id, l]));

const linkedEras = location.data.eras
  .map((ref) => erasById.get(ref.id))
  .filter((era): era is CollectionEntry<"eras"> => Boolean(era));

const notesForLocation = allNotes
  .filter((note) => note.data.location.id === location.id)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const noteCounts = allNotes.reduce<Record<string, number>>((acc, note) => {
  const key = note.data.location.id;
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});

const gradient = getLocationGradient(location.slug);
---

<BaseLayout title={`${location.data.name} | Bóinne`} description={location.data.teaser} darkHeader={true}>
  <!-- Hero -->
  <section class="relative min-h-[50vh] flex items-end overflow-hidden placeholder-shimmer" style={`background: ${gradient};`}>
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pb-12 pt-32">
      <div class="flex flex-wrap gap-2 mb-4">
        {linkedEras.map(era => (
          <EraPill era={era} variant="light" />
        ))}
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white">{location.data.name}</h1>
      <p class="mt-2 text-sm text-white/50">{location.data.county}</p>
      <p class="mt-4 text-lg text-white/70 max-w-2xl leading-relaxed">{location.data.teaser}</p>
      <p class="mt-4 text-sm text-white/40">{location.data.lat.toFixed(4)}° N, {Math.abs(location.data.lng).toFixed(4)}° W</p>
    </div>
  </section>

  <!-- Content -->
  <section class="px-6 py-16">
    <div class="max-w-3xl mx-auto">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="px-6 pb-16">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-stone-400 mb-6">Location</h2>
      <DiscoveryMap locations={[location]} noteCounts={noteCounts} height="400px" />
    </div>
  </section>

  <!-- Notes -->
  {notesForLocation.length > 0 && (
    <section class="px-6 pb-16">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-stone-400 mb-8 pb-4 border-b border-stone-200">Journal Entries</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {notesForLocation.map(note => (
            <NoteCard note={note} locationById={locationById} erasById={erasById} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
