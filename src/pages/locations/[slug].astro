---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import EraPill from "../../components/EraPill.astro";
import NoteCard from "../../components/NoteCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const locations = await getCollection("locations");

  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props as { location: CollectionEntry<"locations"> };
const { Content } = await render(location);

const [allNotes, allLocations, allEras] = await Promise.all([
  getCollection("posts"),
  getCollection("locations"),
  getCollection("eras"),
]);

const erasById = new Map(allEras.map((era) => [era.id, era]));
const locationById = new Map(allLocations.map((entry) => [entry.id, entry]));

const linkedEras = location.data.eras
  .map((ref) => erasById.get(ref.id))
  .filter((era): era is CollectionEntry<"eras"> => Boolean(era));

const notesForLocation = allNotes
  .filter((note) => note.data.location.id === location.id)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const nearbyLocations = allLocations
  .filter((entry) => entry.id !== location.id)
  .filter((entry) =>
    entry.data.eras.some((entryEra) => location.data.eras.some((locationEra) => locationEra.id === entryEra.id)),
  )
  .slice(0, 2);
---

<BaseLayout
  title={`${location.data.name} | Bóinne`}
  description={location.data.teaser}
  image={location.data.heroImage}
>
  <section class="section-shell mt-8 space-y-6 sm:mt-12">
    <div class="landscape-frame relative min-h-[22rem] overflow-hidden">
      <img src={location.data.heroImage} alt={location.data.name} class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
      <div class="relative z-10 flex h-full flex-col justify-end gap-3 p-6 text-white sm:p-9">
        <p class="chip border-white/35 bg-white/15 text-white">{location.data.county}</p>
        <h1 class="text-5xl sm:text-6xl">{location.data.name}</h1>
        <p class="max-w-2xl text-sm text-white/90 sm:text-base">{location.data.teaser}</p>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[2fr_1fr]">
      <article class="glass-card p-6 sm:p-8">
        <h2 class="text-4xl text-stone-900">Site Overview</h2>
        <div class="mt-4 space-y-4 text-sm text-stone-700 sm:text-base">
          <Content />
        </div>
      </article>

      <aside class="space-y-4">
        <section class="glass-card p-5">
          <h2 class="text-3xl text-stone-900">Coordinates</h2>
          <p class="mt-2 text-sm text-stone-700">
            {location.data.lat.toFixed(4)}, {location.data.lng.toFixed(4)}
          </p>
        </section>

        <section class="glass-card p-5">
          <h2 class="text-3xl text-stone-900">Eras</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {linkedEras.map((era) => <EraPill era={era} />)}
          </div>
        </section>

        <section class="glass-card p-5">
          <h2 class="text-3xl text-stone-900">Tags</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {location.data.tags.map((tag) => (
              <span class="chip">{tag}</span>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </section>

  <section class="section-shell mt-14 space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-4xl text-stone-900">Field Notes for {location.data.name}</h2>
      <a href="/notes/" class="text-sm font-semibold uppercase tracking-[0.08em] text-river">All notes →</a>
    </div>

    {
      notesForLocation.length ? (
        <div class="grid gap-6 md:grid-cols-2">
          {notesForLocation.map((note) => (
            <NoteCard note={note} locationById={locationById} erasById={erasById} />
          ))}
        </div>
      ) : (
        <article class="glass-card p-6 text-sm text-stone-700">
          No notes yet for this location. Add one in <code>src/content/posts</code> and reference <code>{location.slug}</code>
          in the <code>location</code> field.
        </article>
      )
    }
  </section>

  <section class="section-shell mt-14 pb-4">
    <h2 class="text-4xl text-stone-900">Related Nearby Context</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {nearbyLocations.map((entry) => (
        <a href={`/locations/${entry.slug}/`} class="glass-card block p-5 transition hover:-translate-y-0.5">
          <p class="text-xs font-semibold uppercase tracking-[0.08em] text-stone-500">{entry.data.county}</p>
          <h3 class="mt-1 text-3xl text-stone-900">{entry.data.name}</h3>
          <p class="mt-2 text-sm text-stone-700">{entry.data.teaser}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
