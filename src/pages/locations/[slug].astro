---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import EraPill from "../../components/EraPill.astro";
import NoteCard from "../../components/NoteCard.astro";
import DiscoveryMap from "../../components/DiscoveryMap.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocationGradient } from "../../lib/images";

export async function getStaticPaths() {
  const locations = await getCollection("locations");
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props as { location: CollectionEntry<"locations"> };
const { Content } = await render(location);

const [allNotes, allLocations, allEras] = await Promise.all([
  getCollection("posts"),
  getCollection("locations"),
  getCollection("eras"),
]);

const erasById = new Map(allEras.map((e) => [e.id, e]));
const locationById = new Map(allLocations.map((l) => [l.id, l]));

const linkedEras = location.data.eras
  .map((ref) => erasById.get(ref.id))
  .filter((era): era is CollectionEntry<"eras"> => Boolean(era));

const notesForLocation = allNotes
  .filter((note) => note.data.location.id === location.id)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const noteCounts = allNotes.reduce<Record<string, number>>((acc, note) => {
  const key = note.data.location.id;
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});

const gradient = getLocationGradient(location.slug);
---

<BaseLayout title={`${location.data.name} | Bóinne`} description={location.data.teaser}>
  <!-- Hero -->
  <section class="relative min-h-[55vh] flex items-end overflow-hidden vignette placeholder-shimmer" style={`background: ${gradient};`}>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent" />
    <div class="relative z-10 w-full max-w-3xl mx-auto px-6 pb-14 pt-36">
      <div class="flex flex-wrap gap-2 mb-4">
        {linkedEras.map(era => (
          <EraPill era={era} variant="light" />
        ))}
      </div>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-white">{location.data.name}</h1>
      <p class="mt-3 text-white/40 text-sm">{location.data.county}</p>
    </div>
  </section>

  <!-- Key facts + teaser -->
  <section class="px-6 py-16">
    <div class="max-w-3xl mx-auto">
      <p class="text-lg text-stone-600 leading-relaxed font-light reveal">{location.data.teaser}</p>
      <div class="mt-8 facts-grid reveal">
        <div class="fact">
          <p class="fact-label">Coordinates</p>
          <p class="fact-value">{location.data.lat.toFixed(4)}° N</p>
          <p class="fact-detail">{Math.abs(location.data.lng).toFixed(4)}° W</p>
        </div>
        <div class="fact">
          <p class="fact-label">County</p>
          <p class="fact-value">{location.data.county}</p>
        </div>
        <div class="fact">
          <p class="fact-label">Eras</p>
          <p class="fact-value">{linkedEras.length}</p>
          <p class="fact-detail">{linkedEras.map(e => e.data.name).join(', ')}</p>
        </div>
        <div class="fact">
          <p class="fact-label">Journal Entries</p>
          <p class="fact-value">{notesForLocation.length}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="px-6 pb-16">
    <div class="max-w-3xl mx-auto reveal">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="px-6 py-16 bg-dark">
    <div class="max-w-5xl mx-auto">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-gold/50 mb-6">Location</p>
      <div class="reveal">
        <DiscoveryMap locations={[location]} noteCounts={noteCounts} height="400px" />
      </div>
    </div>
  </section>

  <!-- Notes -->
  {notesForLocation.length > 0 && (
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-stone-400 mb-2">From This Site</p>
        <h2 class="font-display text-2xl font-bold text-stone-900 mb-8">Journal Entries</h2>
        <div class="reveal">
          {notesForLocation.map(note => (
            <NoteCard note={note} locationById={locationById} erasById={erasById} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
