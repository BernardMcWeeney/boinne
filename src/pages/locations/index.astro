---
import { getCollection } from "astro:content";
import LocationCard from "../../components/LocationCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const [locations, notes, eras] = await Promise.all([
  getCollection("locations"),
  getCollection("posts"),
  getCollection("eras"),
]);

const erasById = new Map(eras.map((e) => [e.id, e]));
const noteCounts = notes.reduce<Record<string, number>>((acc, note) => {
  const key = note.data.location.id;
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});

const sortedLocations = [...locations].sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout title="Locations | Bóinne" description="Explore the ancient sites of the Boyne Valley">
  <!-- Dark header area -->
  <section class="bg-dark pt-28 pb-16 px-6">
    <div class="max-w-3xl mx-auto">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-gold/50 mb-3">Site Register</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white">Locations</h1>
      <p class="mt-4 text-base text-white/40 leading-relaxed max-w-xl">
        From Neolithic passage tombs older than the pyramids to medieval castles
        and battlefields that shaped a nation. Every site has a story.
      </p>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-3xl mx-auto">
      {sortedLocations.map(loc => (
        <LocationCard location={loc} erasById={erasById} noteCount={noteCounts[loc.id] ?? 0} />
      ))}
    </div>
  </section>
</BaseLayout>
