---
import { getCollection } from "astro:content";
import NoteCard from "../../components/NoteCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const [notes, locations, eras] = await Promise.all([
  getCollection("posts"),
  getCollection("locations"),
  getCollection("eras"),
]);

const notesSorted = [...notes].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const locationById = new Map(locations.map((l) => [l.id, l]));
const erasById = new Map(eras.map((e) => [e.id, e]));
---

<BaseLayout title="Journal | Bóinne" description="Writings and explorations across the Boyne Valley">
  <section class="bg-dark pt-28 pb-16 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="mb-6">
        <Breadcrumbs crumbs={[
          { label: 'Home', href: '/' },
          { label: 'Journal' },
        ]} variant="light" />
      </div>
      <p class="text-[11px] font-semibold uppercase tracking-wider text-gold/50 mb-3">Field Notes</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white">Journal</h1>
      <p class="mt-4 text-base text-white/40 leading-relaxed max-w-xl">
        Explorations, histories, and reflections from across the Boyne Valley.
        Each entry is a window into a different time and place.
      </p>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-5xl mx-auto">
      <div class="card-grid">
        {notesSorted.map(note => (
          <NoteCard note={note} locationById={locationById} erasById={erasById} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
