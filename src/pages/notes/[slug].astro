---
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntries, getEntry, render } from "astro:content";
import EraPill from "../../components/EraPill.astro";
import NoteCard from "../../components/NoteCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocationGradient } from "../../lib/images";

export async function getStaticPaths() {
  const notes = await getCollection("posts");
  return notes.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"posts"> };
const { Content } = await render(post);

const [location, allEras, allLocations, allNotes] = await Promise.all([
  getEntry(post.data.location),
  getCollection("eras"),
  getCollection("locations"),
  getCollection("posts"),
]);

const erasById = new Map(allEras.map((e) => [e.id, e]));
const locationById = new Map(allLocations.map((l) => [l.id, l]));

const linkedEras = post.data.eras
  .map((ref) => erasById.get(ref.id))
  .filter((era): era is CollectionEntry<"eras"> => Boolean(era));

const relatedNotes = post.data.related.length ? await getEntries(post.data.related) : [];

if (!location) throw new Error(`Location not found for post ${post.slug}`);

const gradient = getLocationGradient(location.slug);

const formattedDate = post.data.publishedAt.toLocaleDateString('en-IE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} | Bóinne`} description={post.data.excerpt}>
  <!-- Hero -->
  <section class="relative min-h-[50vh] flex items-end overflow-hidden vignette placeholder-shimmer" style={`background: ${gradient};`}>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent" />
    <div class="relative z-10 w-full max-w-3xl mx-auto px-6 pb-14 pt-36">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        {linkedEras.map(era => (
          <EraPill era={era} variant="light" />
        ))}
        <a href={`/locations/${location.slug}/`} class="inline-flex items-center gap-1.5 text-[11px] font-medium text-white/40 hover:text-gold transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          {location.data.name}
        </a>
      </div>
      <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-tight max-w-3xl">{post.data.title}</h1>
      <time class="block mt-4 text-sm text-white/30" datetime={post.data.publishedAt.toISOString()}>{formattedDate}</time>
    </div>
  </section>

  <!-- Content -->
  <article class="px-6 py-16">
    <div class="max-w-3xl mx-auto">
      <div class="prose reveal">
        <Content />
      </div>
    </div>
  </article>

  <!-- Location reference -->
  <section class="px-6 pb-16">
    <div class="max-w-3xl mx-auto reveal">
      <a href={`/locations/${location.slug}/`} class="group flex items-center gap-4 p-5 bg-surface-warm border border-stone-200/80 rounded-lg hover:border-gold-dim/40 transition-all">
        <div class="flex-shrink-0 w-12 h-12 rounded-lg overflow-hidden placeholder-shimmer relative" style={`background: ${gradient};`} />
        <div class="flex-1 min-w-0">
          <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">Location</p>
          <p class="font-display text-base font-bold text-stone-900 group-hover:text-gold-dim transition-colors">{location.data.name}</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-stone-300 group-hover:text-gold-dim group-hover:translate-x-0.5 transition-all">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Related -->
  {relatedNotes.length > 0 && (
    <section class="px-6 pb-20">
      <div class="max-w-3xl mx-auto">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-stone-400 mb-2">Continue Reading</p>
        <h2 class="font-display text-2xl font-bold text-stone-900 mb-6">Related Writings</h2>
        <div class="reveal">
          {relatedNotes.map(related => (
            <NoteCard note={related} locationById={locationById} erasById={erasById} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
