---
import { getCollection } from "astro:content";
import DiscoveryMap from "../components/DiscoveryMap.astro";
import EraPill from "../components/EraPill.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const [locations, notes, eras] = await Promise.all([
  getCollection("locations"),
  getCollection("posts"),
  getCollection("eras"),
]);

const erasById = new Map(eras.map((era) => [era.id, era]));

const noteCounts = notes.reduce<Record<string, number>>((acc, note) => {
  const key = note.data.location.id;
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});

const locationsSorted = [...locations].sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title="Discovery Map | Bóinne"
  description="Map every Boyne Valley location with linked historical notes and eras."
>
  <section class="section-shell mt-10 space-y-6 sm:mt-12">
    <div class="space-y-3">
      <p class="chip">Map View</p>
      <h1 class="text-5xl text-stone-900 sm:text-6xl">Discovery Map</h1>
      <p class="max-w-3xl text-sm text-stone-700 sm:text-base">
        Locations are positioned from latitude and longitude in your content files. Each marker shows how many linked
        field notes have been published.
      </p>
    </div>
    <DiscoveryMap locations={locationsSorted} noteCounts={noteCounts} />
  </section>

  <section class="section-shell mt-12 space-y-5 pb-4">
    <h2 class="text-4xl text-stone-900">Site Register</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {locationsSorted.map((location) => {
        const linkedEras = location.data.eras
          .map((ref) => erasById.get(ref.id))
          .filter((era) => Boolean(era));

        return (
          <article class="glass-card p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h3 class="text-3xl text-stone-900">
                  <a href={`/locations/${location.slug}/`}>{location.data.name}</a>
                </h3>
                <p class="text-sm text-stone-600">{location.data.county}</p>
              </div>
              <span class="chip">{noteCounts[location.id] ?? 0} notes</span>
            </div>
            <p class="mt-3 text-sm text-stone-700">{location.data.teaser}</p>
            <p class="mt-3 text-xs font-semibold uppercase tracking-[0.08em] text-stone-500">
              {location.data.lat.toFixed(4)}, {location.data.lng.toFixed(4)}
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {linkedEras.map((era) => era && <EraPill era={era} />)}
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
